rules_version = '2';

// Weberplex — every rule the site depends on lives here. There is no server
// in the write path: browsers write straight to Firestore, so these rules ARE
// the backend. Guests are identified by name only (by design). The owner
// proves the key by writing a fresh `hostops/{op}` doc carrying it in the same
// batch as the change; the key doc itself is never readable.
//
// Data: a shelf of movies (top-level, it only grows), thumbs and "seen it"
// marks per person, free evenings per person, and nights (one doc per day,
// created by whoever volunteers to host it).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function validKey(k) {
      return k is string && k.size() >= 1 && k.size() <= 32
        && k.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }
    function validName(s) { return s is string && s.size() >= 1 && s.size() <= 24; }
    function validDay(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function stamped(d) { return d.at == request.time; }

    function hostKey() { return get(/databases/$(database)/documents/config/host).data.key; }

    // A host op is valid only if its hostops doc is created in THIS batch (so
    // an old op id can't be replayed) and carries the key.
    function freshHostOp(op) {
      return op is string && op.matches('^[A-Za-z0-9]{16,48}$')
        && !exists(/databases/$(database)/documents/hostops/$(op))
        && getAfter(/databases/$(database)/documents/hostops/$(op)).data.key == hostKey();
    }
    // True when this batch re-stamps config/season with a fresh owner op.
    function ownerTouched() {
      return freshHostOp(getAfter(/databases/$(database)/documents/config/season).data.op);
    }
    function movieExists(id) { return exists(/databases/$(database)/documents/movies/$(id)); }

    // ---- owner plumbing -----------------------------------------------------
    match /config/host {
      allow read, delete: if false;
      // One-shot: once it exists, a second set() is an update and is refused.
      allow create: if request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string && request.resource.data.key.size() >= 20;
      // The owner changes the password by proving the current one in the same
      // batch (hostKey() reads the stored doc as it was before this write).
      allow update: if request.resource.data.keys().hasOnly(['key', 'op'])
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 8 && request.resource.data.key.size() <= 200
        && freshHostOp(request.resource.data.op);
    }
    match /config/season {
      allow read: if true;
      allow create, update: if freshHostOp(request.resource.data.op)
        && request.resource.data.keys().hasOnly(['op', 'title'])
        && (!('title' in request.resource.data)
            || (request.resource.data.title is string && request.resource.data.title.size() <= 60));
      allow delete: if false;
    }
    match /hostops/{op} {
      allow read, update, delete: if false;
      allow create: if op.matches('^[A-Za-z0-9]{16,48}$')
        && request.resource.data.keys().hasOnly(['key', 'at'])
        && request.resource.data.key is string && stamped(request.resource.data);
    }
    // "Show on the Shield": Home Assistant polls this doc and opens the movie.
    match /control/shield {
      allow read: if true;
      allow create, update: if freshHostOp(request.resource.data.op)
        && request.resource.data.keys().hasOnly(['imdb', 'title', 'seq', 'op', 'at'])
        && request.resource.data.imdb is string && request.resource.data.imdb.matches('^tt[0-9]{5,10}$')
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.seq is int && stamped(request.resource.data);
      allow delete: if false;
    }

    // ---- people -------------------------------------------------------------
    match /people/{key} {
      allow read: if true;
      allow create: if validKey(key) && validName(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['name', 'at']) && stamped(request.resource.data);
      // Each person's place in the site, kept here instead of in the browser:
      // when they last looked, the walkthrough, their usual start time, and
      // which tie reels they've already watched. Name and join date are fixed.
      allow update: if request.resource.data.keys().hasOnly(['name', 'at', 'lastSeen', 'toured', 'hostTime', 'reels'])
        && request.resource.data.name == resource.data.name && request.resource.data.at == resource.data.at
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is timestamp)
        && (!('toured' in request.resource.data) || request.resource.data.toured is bool)
        && (!('hostTime' in request.resource.data)
            || (request.resource.data.hostTime is string && request.resource.data.hostTime.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && (!('reels' in request.resource.data)
            || (request.resource.data.reels is list && request.resource.data.reels.size() <= 20));
      allow delete: if false;
    }

    // ---- the shelf ----------------------------------------------------------
    // Guests add movies under their name; house picks (by == '') need the
    // owner key. Movies are never edited. Anyone may take a guest's movie off
    // the shelf (name-only trust); house picks only come off with the key.
    match /movies/{m} {
      allow read: if true;
      allow create: if m.matches('^tt[0-9]{5,10}$')
        && request.resource.data.keys().hasOnly(['imdbId', 'title', 'year', 'poster', 'runtime', 'rating', 'genres',
             'trailer', 'description', 'pitch', 'shelf', 'by', 'byName', 'at'])
        && request.resource.data.imdbId == m
        && request.resource.data.title is string && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && request.resource.data.poster is string && request.resource.data.poster.size() <= 300
        && request.resource.data.genres is list && request.resource.data.genres.size() <= 6
        && request.resource.data.year is string && request.resource.data.year.size() <= 12
        && request.resource.data.runtime is string && request.resource.data.runtime.size() <= 20
        && request.resource.data.rating is string && request.resource.data.rating.size() <= 6
        && request.resource.data.trailer is string && request.resource.data.trailer.matches('^[A-Za-z0-9_-]{0,32}$')
        && (!('pitch' in request.resource.data)
            || (request.resource.data.pitch is string && request.resource.data.pitch.size() <= 140))
        && (!('shelf' in request.resource.data)
            || (request.resource.data.shelf is list && request.resource.data.shelf.size() <= 4))
        && validName(request.resource.data.byName) && stamped(request.resource.data)
        && ((validKey(request.resource.data.by) && !('shelf' in request.resource.data))
            || (request.resource.data.by == '' && ownerTouched()));
      allow delete: if resource.data.by != '' || ownerTouched();
      allow update: if false;
    }

    // Thumbs-up ("I'd watch it") and "seen it": one doc per person per movie.
    match /votes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['movie', 'title', 'nameKey', 'name', 'at'])
        && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
        && request.resource.data.movie is string
        && id == request.resource.data.movie + '__' + request.resource.data.nameKey
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && existsAfter(/databases/$(database)/documents/movies/$(request.resource.data.movie))
        && stamped(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }
    match /seen/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['movie', 'nameKey', 'name', 'at'])
        && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
        && request.resource.data.movie is string
        && id == request.resource.data.movie + '__' + request.resource.data.nameKey
        && movieExists(request.resource.data.movie) && stamped(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    // ---- the calendar -------------------------------------------------------
    match /free/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['day', 'nameKey', 'name', 'at'])
        && validDay(request.resource.data.day)
        && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
        && id == request.resource.data.day + '__' + request.resource.data.nameKey
        && stamped(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    // ---- nights ---------------------------------------------------------------
    // One per day, created by its volunteer host. Allowed changes:
    //   planned -> planned   new start time, a theme, one person's veto (set or cleared), one person's
    //                        ballot vote or write-in (set, moved or cleared), each with its own stamp
    //                        for "Since you last looked"; or a person dropping out, who takes all three back
    //   planned -> locked    the movie is picked (by a phone or the server clock), with the ballot's count
    //   locked  -> planned   unlock before showtime
    //   locked  -> done      after showtime
    //   planned/locked -> cancelled, and cancelled -> planned (someone re-hosts)
    // A theme is free text (a shelf tag or genre); nights from before themes
    // and vetoes existed have neither field, so every rule reads them with get().
    // Server-stamped fields feed "Since you last looked": `movedAt` (the start
    // time changed), `themeAt` (the theme changed), and `vetoAt`, `ballotVoteAt`,
    // `writeInAt` (when each person's veto, vote and write-in was set), all equal to
    // request.time when written.
    function validTheme(t) { return t is string && t.size() <= 40; }
    function newNight(day) {
      let d = request.resource.data;
      return validDay(day) && d.day == day
        && d.keys().hasOnly(['day', 'startsAt', 'host', 'hostKey', 'status', 'createdAt',
            'lockedMovieId', 'lockedMovie', 'lockedTie', 'lockedAt', 'finishedAt', 'theme', 'vetoes',
            'themeAt', 'movedAt', 'vetoAt', 'ballotVotes', 'ballotVoteAt', 'writeIns', 'writeInAt'])
        && d.status == 'planned' && d.startsAt is timestamp && d.startsAt > request.time
        && validName(d.host) && validKey(d.hostKey)
        && d.createdAt == request.time && d.lockedMovieId == null && d.lockedAt == null
        && validTheme(d.get('theme', '')) && d.get('vetoes', {}) == {}
        && d.get('themeAt', null) == null && d.get('movedAt', null) == null && d.get('vetoAt', {}) == {}
        && d.get('ballotVotes', {}) == {} && d.get('ballotVoteAt', {}) == {}
        && d.get('writeIns', {}) == {} && d.get('writeInAt', {}) == {};
    }
    // One person's entry in a per-person map on the night (`vetoes`, `ballotVotes`,
    // `writeIns`: nameKey -> movie id), kept with its stamp map (`vetoAt`, ...). Exactly
    // one key of the map changes, and its stamp changes with it: to the request time when
    // the entry is set, gone when it is cleared. At most 30 entries.
    //   set or clear: the key belongs to the host or to someone free that evening, and a
    //   set value is a movie on the shelf.
    //   moved (`inPlace`, for votes and write-ins): the same key holds a new movie. A rule
    //   can't pull one key out of a changed set, so the new movie (the one value the map
    //   didn't hold before) must be on the shelf; whose key it is was checked when it was set.
    function entrySetOrCleared(day, before, after, field, stamps, canSet) {
      let was = before.get(field, {});
      let now = after.get(field, {});
      let added = now.keys().removeAll(was.keys());
      let gone = was.keys().removeAll(now.keys());
      let k = added.size() == 1 ? added[0] : gone[0];
      return now.diff(was).affectedKeys().size() == 1 && added.size() + gone.size() == 1
        && (canSet || gone.size() == 1)
        && validKey(k)
        && (k == before.hostKey || exists(/databases/$(database)/documents/free/$(day + '__' + k)))
        && (gone.size() == 1 || (now[k] is string && movieExists(now[k])))
        && after.get(stamps, {}).diff(before.get(stamps, {})).affectedKeys().hasOnly([k])
        && (gone.size() == 1 ? !(k in after.get(stamps, {})) : after[stamps][k] == request.time);
    }
    function entryMoved(before, after, field, stamps) {
      let was = before.get(field, {});
      let now = after.get(field, {});
      let touched = now.diff(was).affectedKeys();
      let fresh = now.values().removeAll(was.values());
      let newStamps = after.get(stamps, {}).values().removeAll(before.get(stamps, {}).values());
      return touched.size() == 1 && now.keys().removeAll(was.keys()).size() == 0 && was.keys().removeAll(now.keys()).size() == 0
        && fresh.size() <= 1 && (fresh.size() == 0 || (fresh[0] is string && movieExists(fresh[0])))
        && after.get(stamps, {}).diff(before.get(stamps, {})).affectedKeys().size() == 1
        && touched.hasAll(after.get(stamps, {}).diff(before.get(stamps, {})).affectedKeys())
        && newStamps.size() == 1 && newStamps[0] == request.time;
    }
    function personEntryOk(day, before, after, field, stamps, inPlace) {
      return after.get(field, {}) is map && after.get(stamps, {}) is map
        && before.get(field, {}) is map && before.get(stamps, {}) is map
        && after.get(field, {}).size() <= 30
        && (entrySetOrCleared(day, before, after, field, stamps, true)
            || (inPlace && entryMoved(before, after, field, stamps)));
    }
    // Dropping out of a night takes your veto, vote and write-in in one write: each of the
    // three maps is left alone or has one entry cleared (the same checks as clearing it alone).
    function entryDropped(day, before, after, field, stamps) {
      return (after.get(field, {}) == before.get(field, {}) && after.get(stamps, {}) == before.get(stamps, {}))
        || (after.get(field, {}) is map && after.get(stamps, {}) is map
            && before.get(field, {}) is map && before.get(stamps, {}) is map
            && entrySetOrCleared(day, before, after, field, stamps, false));
    }
    // An unlock leaves lockedVotes null; the next lock may leave it as it is.
    function lockedVotesOk(d) { return d.get('lockedVotes', null) == null || (d.lockedVotes is map && d.lockedVotes.size() <= 40); }
    function nightChangeOk(day) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['startsAt', 'movedAt']) && after.startsAt is timestamp && after.startsAt > request.time
            && (!('movedAt' in changed) || after.movedAt == request.time))
        || (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['theme', 'themeAt']) && validTheme(after.get('theme', ''))
            && (!('themeAt' in changed) || after.themeAt == request.time))
        || (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['vetoes', 'vetoAt']) && personEntryOk(day, before, after, 'vetoes', 'vetoAt', false))
        || (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['ballotVotes', 'ballotVoteAt']) && personEntryOk(day, before, after, 'ballotVotes', 'ballotVoteAt', true))
        || (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['writeIns', 'writeInAt']) && personEntryOk(day, before, after, 'writeIns', 'writeInAt', true))
        || (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['vetoes', 'vetoAt', 'ballotVotes', 'ballotVoteAt', 'writeIns', 'writeInAt'])
            && entryDropped(day, before, after, 'vetoes', 'vetoAt')
            && entryDropped(day, before, after, 'ballotVotes', 'ballotVoteAt')
            && entryDropped(day, before, after, 'writeIns', 'writeInAt'))
        || (before.status == 'planned' && after.status == 'locked'
            && changed.hasOnly(['status', 'lockedMovieId', 'lockedMovie', 'lockedTie', 'lockedAt', 'lockedVotes'])
            && after.lockedAt == request.time && movieExists(after.lockedMovieId) && lockedVotesOk(after))
        || (before.status == 'locked' && after.status == 'planned' && request.time < before.startsAt
            && changed.hasOnly(['status', 'lockedMovieId', 'lockedMovie', 'lockedTie', 'lockedAt', 'lockedVotes'])
            && after.lockedMovieId == null && after.get('lockedVotes', null) == null)
        || (before.status == 'locked' && after.status == 'done' && request.time > before.startsAt
            && changed.hasOnly(['status', 'finishedAt']) && after.finishedAt == request.time)
        || (before.status in ['planned', 'locked'] && after.status == 'cancelled' && request.time < before.startsAt
            && changed.hasOnly(['status', 'finishedAt']))
        || (before.status == 'cancelled' && newNight(day));
    }

    match /nights/{day} {
      allow read: if true;
      allow create: if newNight(day);
      allow update: if nightChangeOk(day);
      allow delete: if false;

      match /snacks/{id} {
        allow read: if true;
        allow create: if get(/databases/$(database)/documents/nights/$(day)).data.status in ['planned', 'locked']
          && request.resource.data.keys().hasOnly(['item', 'nameKey', 'name', 'at'])
          && request.resource.data.item is string
          && request.resource.data.item.size() >= 1 && request.resource.data.item.size() <= 40
          && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
          && stamped(request.resource.data);
        allow delete: if get(/databases/$(database)/documents/nights/$(day)).data.status in ['planned', 'locked'];
        allow update: if false;
      }

      // Reviews open once the showtime has passed.
      match /reviews/{key} {
        allow read: if true;
        allow create, update: if get(/databases/$(database)/documents/nights/$(day)).data.status in ['locked', 'done']
          && request.time > get(/databases/$(database)/documents/nights/$(day)).data.startsAt
          && request.resource.data.keys().hasOnly(['stars', 'line', 'nameKey', 'name', 'at'])
          && key == request.resource.data.nameKey && validKey(key)
          && validName(request.resource.data.name)
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.line is string && request.resource.data.line.size() <= 140
          && stamped(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
