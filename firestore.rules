rules_version = '2';

// Weberplex — every rule the site depends on lives here. There is no server
// in the write path: browsers write straight to Firestore, so these rules ARE
// the backend. Guests are identified by name only (by design). The owner
// proves the key by writing a fresh `hostops/{op}` doc carrying it in the same
// batch as the change; the key doc itself is never readable.
//
// Data: a shelf of movies (top-level, it only grows), thumbs and "seen it"
// marks per person, free evenings per person, and nights (one doc per day,
// created by whoever volunteers to host it).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function validKey(k) {
      return k is string && k.size() >= 1 && k.size() <= 32
        && k.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }
    function validName(s) { return s is string && s.size() >= 1 && s.size() <= 24; }
    function validDay(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function stamped(d) { return d.at == request.time; }

    function hostKey() { return get(/databases/$(database)/documents/config/host).data.key; }

    // A host op is valid only if its hostops doc is created in THIS batch (so
    // an old op id can't be replayed) and carries the key.
    function freshHostOp(op) {
      return op is string && op.matches('^[A-Za-z0-9]{16,48}$')
        && !exists(/databases/$(database)/documents/hostops/$(op))
        && getAfter(/databases/$(database)/documents/hostops/$(op)).data.key == hostKey();
    }
    // True when this batch re-stamps config/season with a fresh owner op.
    function ownerTouched() {
      return freshHostOp(getAfter(/databases/$(database)/documents/config/season).data.op);
    }
    function movieExists(id) { return exists(/databases/$(database)/documents/movies/$(id)); }

    // ---- owner plumbing -----------------------------------------------------
    match /config/host {
      allow read, update, delete: if false;
      // One-shot: once it exists, a second set() is an update and is refused.
      allow create: if request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string && request.resource.data.key.size() >= 20;
    }
    match /config/season {
      allow read: if true;
      allow create, update: if freshHostOp(request.resource.data.op)
        && request.resource.data.keys().hasOnly(['op', 'title'])
        && (!('title' in request.resource.data)
            || (request.resource.data.title is string && request.resource.data.title.size() <= 60));
      allow delete: if false;
    }
    match /hostops/{op} {
      allow read, update, delete: if false;
      allow create: if op.matches('^[A-Za-z0-9]{16,48}$')
        && request.resource.data.keys().hasOnly(['key', 'at'])
        && request.resource.data.key is string && stamped(request.resource.data);
    }
    // "Show on the Shield": Home Assistant polls this doc and opens the movie.
    match /control/shield {
      allow read: if true;
      allow create, update: if freshHostOp(request.resource.data.op)
        && request.resource.data.keys().hasOnly(['imdb', 'title', 'seq', 'op', 'at'])
        && request.resource.data.imdb is string && request.resource.data.imdb.matches('^tt[0-9]{5,10}$')
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.seq is int && stamped(request.resource.data);
      allow delete: if false;
    }

    // ---- people -------------------------------------------------------------
    match /people/{key} {
      allow read: if true;
      allow create: if validKey(key) && validName(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['name', 'at']) && stamped(request.resource.data);
      allow update, delete: if false;
    }

    // ---- the shelf ----------------------------------------------------------
    // Guests add movies under their name; house picks (by == '') need the
    // owner key. Movies are never edited. Anyone may take a guest's movie off
    // the shelf (name-only trust); house picks only come off with the key.
    match /movies/{m} {
      allow read: if true;
      allow create: if m.matches('^tt[0-9]{5,10}$')
        && request.resource.data.keys().hasOnly(['imdbId', 'title', 'year', 'poster', 'runtime', 'rating', 'genres',
             'trailer', 'description', 'pitch', 'shelf', 'by', 'byName', 'at'])
        && request.resource.data.imdbId == m
        && request.resource.data.title is string && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && request.resource.data.poster is string && request.resource.data.poster.size() <= 300
        && request.resource.data.genres is list && request.resource.data.genres.size() <= 6
        && request.resource.data.year is string && request.resource.data.year.size() <= 12
        && request.resource.data.runtime is string && request.resource.data.runtime.size() <= 20
        && request.resource.data.rating is string && request.resource.data.rating.size() <= 6
        && request.resource.data.trailer is string && request.resource.data.trailer.matches('^[A-Za-z0-9_-]{0,32}$')
        && (!('pitch' in request.resource.data)
            || (request.resource.data.pitch is string && request.resource.data.pitch.size() <= 140))
        && (!('shelf' in request.resource.data)
            || (request.resource.data.shelf is list && request.resource.data.shelf.size() <= 4))
        && validName(request.resource.data.byName) && stamped(request.resource.data)
        && ((validKey(request.resource.data.by) && !('shelf' in request.resource.data))
            || (request.resource.data.by == '' && ownerTouched()));
      allow delete: if resource.data.by != '' || ownerTouched();
      allow update: if false;
    }

    // Thumbs-up ("I'd watch it") and "seen it": one doc per person per movie.
    match /votes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['movie', 'title', 'nameKey', 'name', 'at'])
        && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
        && request.resource.data.movie is string
        && id == request.resource.data.movie + '__' + request.resource.data.nameKey
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && existsAfter(/databases/$(database)/documents/movies/$(request.resource.data.movie))
        && stamped(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }
    match /seen/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['movie', 'nameKey', 'name', 'at'])
        && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
        && request.resource.data.movie is string
        && id == request.resource.data.movie + '__' + request.resource.data.nameKey
        && movieExists(request.resource.data.movie) && stamped(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    // ---- the calendar -------------------------------------------------------
    match /free/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['day', 'nameKey', 'name', 'at'])
        && validDay(request.resource.data.day)
        && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
        && id == request.resource.data.day + '__' + request.resource.data.nameKey
        && stamped(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    // ---- nights ---------------------------------------------------------------
    // One per day, created by its volunteer host. Allowed changes:
    //   planned -> planned   new start time
    //   planned -> locked    the movie is picked (by a phone or the server clock)
    //   locked  -> planned   unlock before showtime
    //   locked  -> done      after showtime
    //   planned/locked -> cancelled, and cancelled -> planned (someone re-hosts)
    function newNight(day) {
      let d = request.resource.data;
      return validDay(day) && d.day == day
        && d.keys().hasOnly(['day', 'startsAt', 'host', 'hostKey', 'status', 'createdAt',
            'lockedMovieId', 'lockedMovie', 'lockedTie', 'lockedAt', 'finishedAt'])
        && d.status == 'planned' && d.startsAt is timestamp && d.startsAt > request.time
        && validName(d.host) && validKey(d.hostKey)
        && d.createdAt == request.time && d.lockedMovieId == null && d.lockedAt == null;
    }
    function nightChangeOk(day) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return (before.status == 'planned' && after.status == 'planned'
            && changed.hasOnly(['startsAt']) && after.startsAt is timestamp && after.startsAt > request.time)
        || (before.status == 'planned' && after.status == 'locked'
            && changed.hasOnly(['status', 'lockedMovieId', 'lockedMovie', 'lockedTie', 'lockedAt'])
            && after.lockedAt == request.time && movieExists(after.lockedMovieId))
        || (before.status == 'locked' && after.status == 'planned' && request.time < before.startsAt
            && changed.hasOnly(['status', 'lockedMovieId', 'lockedMovie', 'lockedTie', 'lockedAt'])
            && after.lockedMovieId == null)
        || (before.status == 'locked' && after.status == 'done' && request.time > before.startsAt
            && changed.hasOnly(['status', 'finishedAt']) && after.finishedAt == request.time)
        || (before.status in ['planned', 'locked'] && after.status == 'cancelled' && request.time < before.startsAt
            && changed.hasOnly(['status', 'finishedAt']))
        || (before.status == 'cancelled' && newNight(day));
    }

    match /nights/{day} {
      allow read: if true;
      allow create: if newNight(day);
      allow update: if nightChangeOk(day);
      allow delete: if false;

      match /snacks/{id} {
        allow read: if true;
        allow create: if get(/databases/$(database)/documents/nights/$(day)).data.status in ['planned', 'locked']
          && request.resource.data.keys().hasOnly(['item', 'nameKey', 'name', 'at'])
          && request.resource.data.item is string
          && request.resource.data.item.size() >= 1 && request.resource.data.item.size() <= 40
          && validKey(request.resource.data.nameKey) && validName(request.resource.data.name)
          && stamped(request.resource.data);
        allow delete: if get(/databases/$(database)/documents/nights/$(day)).data.status in ['planned', 'locked'];
        allow update: if false;
      }

      // Reviews open once the showtime has passed.
      match /reviews/{key} {
        allow read: if true;
        allow create, update: if get(/databases/$(database)/documents/nights/$(day)).data.status in ['locked', 'done']
          && request.time > get(/databases/$(database)/documents/nights/$(day)).data.startsAt
          && request.resource.data.keys().hasOnly(['stars', 'line', 'nameKey', 'name', 'at'])
          && key == request.resource.data.nameKey && validKey(key)
          && validName(request.resource.data.name)
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.line is string && request.resource.data.line.size() <= 140
          && stamped(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
